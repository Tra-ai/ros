# Add real values in Vercel Project Settings > Environment Variables.
# Never commit real secrets to GitHub.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
# Optional: allow a web client from this origin (CORS). Leave unset for mobile/native clients.
# ALLOWED_ORIGIN=https://your-game-site.example
